# vim: set ft=zsh:

ssh_autocd() {
    local host="$1"
    shift

    if [[ "$host" == raspi.media* ]]; then
        /usr/bin/env TERM=xterm-256color ssh -t "$host" 'cd /media/ext1; exec $SHELL -i' "$@"
        return $?
    fi

    if [[ "$host" == raspi.services* ]]; then
        /usr/bin/env TERM=xterm-256color ssh -t "$host" 'cd ~/services; exec $SHELL -i' "$@"
        return $?
    fi

    /usr/bin/env TERM=xterm-256color ssh "$host" "$@"
}
